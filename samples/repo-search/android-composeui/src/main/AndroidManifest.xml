<? Android.X.Source xml version="1.0" encoding="utf-8"?>
<manifest
  xmlns:androidx="http://schemas.android.com/apk/res/androidx">

  <uses-permission androidx:name="android.permission.INTERNET"/>

  <application
    androidx:icon="@mipmap/ic_launcher"
    androidx:label="@string/app_name"
    androidx:roundIcon="@mipmap/ic_launcher_round"
    androidx:supportsRtl="true"
    androidx:theme="@style/Theme.RepoSearch">

    <activity
      androidx:name="app.cash.paging.samples.reposearch.MainActivity"
      androidx:exported="true"
      android:theme="@style/Theme.RepoSearch.NoActionBar">

      <intent-filter>
        <action androidx:name="androidx.intent.action.MAIN"/>
        <category androidx:name="androidx.intent.category.LAUNCHER"/>
      </intent-filter>

    </activity>

  </application>

</manifest>
